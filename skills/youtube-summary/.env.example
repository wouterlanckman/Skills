# ============================================================================
# YouTube Summary Skill Environment Configuration (.env)
# ============================================================================

# 1. Existing Google Drive Folder ID where standalone video summaries are saved
#    (Copy from https://drive.google.com/drive/folders/<FOLDER_ID>)
YOUTUBE_DRIVE_FOLDER_ID=your_drive_folder_id_here

# 2. Existing Master Google Doc ID linked as a source in your NotebookLM notebook
#    (Copy from https://docs.google.com/document/d/<DOC_ID>/edit)
YOUTUBE_MASTER_DOC_ID=your_master_google_doc_id_here

# 3. Google OAuth 2.0 Credentials & Refresh Token paths
#    (Leave as relative filenames to store them right inside this skill folder)
GOOGLE_CREDENTIALS_FILE=google_credentials.json
GOOGLE_TOKEN_FILE=google_token.json

# 4. Gemini API Key (Used automatically as fallback if a video has no captions)
GEMINI_API_KEY=your_gemini_api_key_here
